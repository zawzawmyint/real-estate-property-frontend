# Server-only Express origin. Never prefix this with NEXT_PUBLIC_.
API_URL=http://localhost:4311

# Optional: password for pre-provisioned local demo staff accounts.
# Demo login buttons appear only in development when this is configured.
# Use demo.admin@example.com, demo.manager@example.com, demo.agent@example.com.
DEMO_STAFF_PASSWORD=

# Server-only shared inquiry relay secret, >=32 characters, matching Express.
INQUIRY_RELAY_SECRET=
# Production ingress must overwrite this single-IP header and block direct Next access.
# Missing/untrusted client identity fails closed. Dev/test accepts normalized loopback XFF.
INQUIRY_TRUSTED_CLIENT_HEADER=
